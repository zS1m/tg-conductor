# Copy to .env and fill in real values. .env is .gitignore'd.
#
# Quick-generate a master key:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Convention: optional variables stay COMMENTED OUT in this file.
# Uncomment and fill them in only if you need to change the default.
# Empty values (e.g. ``CORS_ORIGINS=``) ARE accepted — settings collapses
# blank strings to None / empty list — but commenting out is cleaner.

# Required ----------------------------------------------------------------
APP_MASTER_KEY=                  # 32-byte raw, base64-encoded (44 chars)

# Required for AI actions (omit if no AI workflows) -----------------------
# OPENAI_API_KEY=                # sk-...
# OPENAI_BASE_URL=               # Azure OpenAI / OpenAI-compatible proxy
# OPENAI_MODEL_CHAT=gpt-4o-mini
# OPENAI_MODEL_VISION=gpt-4o
# OPENAI_PROXY=                  # proxy for OpenAI calls only (independent of
#                                # TG_PROXY). e.g. socks5://127.0.0.1:7890 /
#                                # http://127.0.0.1:7890. Empty → fall back to
#                                # system env (ALL_PROXY / HTTPS_PROXY).

# HTTP server -------------------------------------------------------------
# BIND_HOST=127.0.0.1            # In Docker set 0.0.0.0
# BIND_PORT=8765
# CORS_ORIGINS=                  # comma list, e.g.:
#                                #   CORS_ORIGINS=https://a.example,https://b.example
#                                # empty / unset → CORS disabled

# DB + workflows ----------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///data/tg-conductor.sqlite3
# WORKFLOW_DIR=workflows
# DEFAULT_OWNER_ID=1

# Scheduler timezone ------------------------------------------------------
# Interprets cron expressions + time_window triggers. Default "UTC".
# Set to your local zone so "0 9 * * *" means 09:00 wall-clock, not UTC.
# fire_at is always stored in UTC regardless of this setting.
# SCHEDULER_TZ=Asia/Shanghai

# Telegram throttle (per-account) -----------------------------------------
# TG_PROXY=                      # e.g. socks5://127.0.0.1:7890
#                                # supported schemes: http / socks4 / socks5
# TG_MIN_INTERVAL_SECONDS=1.0
# TG_FLOODWAIT_MAX_RETRIES=3
# TG_FLOODWAIT_PADDING_SECONDS=1.5
# TG_RECONNECT_INITIAL_SECONDS=1.0
# TG_RECONNECT_MAX_SECONDS=300.0

# Execution timeouts + cleanup --------------------------------------------
# JOB_DEFAULT_TIMEOUT_SECONDS=300
# RUN_EVENTS_TTL_DAYS=30         # 0 / -1 disables purging
# RUN_EVENTS_CLEANUP_INTERVAL_SECONDS=3600

# Pricing file ------------------------------------------------------------
# PRICING_FILE=./pricing.yaml
